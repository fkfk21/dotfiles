export CODEX_SLACK_NOTIFY_WEBHOOK_URL='https://hooks.slack.com/services/XXXXX/XXXXX/XXXXX'

# Required for posting unabridged Request/Result text as thread replies.
# The Slack app needs the chat:write scope and access to this channel.
# https://api.slack.com/apps -> OAuth&Permissions -> Bot Token
export CODEX_SLACK_NOTIFY_BOT_TOKEN='xoxb-XXXXX'
export CODEX_SLACK_NOTIFY_CHANNEL_ID='CXXXXX'

# Optional: characters retained for each Request/Result preview. Default: 200.
export CODEX_SLACK_NOTIFY_PREVIEW_LENGTH='200'
